# ======================================================================
# 이광수 멀티에이전트 챗봇 - 환경 변수
# ======================================================================

# ---------- Gemini (agents_2 전체 + agents_3 임베딩용) ----------
GEMINI_API_KEY=your-gemini-api-key-here
# agents_2 LLM 및 agents_3 임베딩 모델
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ---------- Ollama (agents_3 LLM 전용) ----------
OLLAMA_BASE_URL=http://localhost:11434

# 사용할 gemma4 모델 (기본: e4b)
#   더 큰 품질이 필요하면 아래 옵션으로 교체하세요:
#     OLLAMA_MODEL=gemma4:26b
#     OLLAMA_MODEL=gemma4:31b
OLLAMA_MODEL=gemma4:e4b

# gemma4 권장 샘플링 파라미터
OLLAMA_TEMPERATURE=1.0
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64

# ValidatorAgent 만 thinking 모드 ON (true/false)
ENABLE_VALIDATOR_THINKING=true
